// Prisma Schema — Legisla Monitor
// Banco de dados SQLite para desenvolvimento local.
// Para produção, substitua o provider por "postgresql" e ajuste a DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Palavras-chave que o usuário quer monitorar
model Keyword {
  id          String   @id @default(cuid())
  text        String   @unique
  createdAt   DateTime @default(now())
  active      Boolean  @default(true)

  proposicoes ProposicaoKeyword[]
}

// Proposições encontradas nas APIs/scrapers
model Proposicao {
  id               String   @id  // ID numérico da Câmara Federal ou slug da Câmara POA
  numero           Int
  ano              Int
  siglaTipo        String          // PL, PEC, PDL, etc.
  descricaoTipo    String?         // Descrição completa: "Projeto de Lei", etc.
  ementa           String
  ementaDetalhada  String?
  keywordsApi      String?         // Keywords oficiais registradas na Câmara Federal
  dataApresentacao DateTime
  autor            String
  autorUri         String?         // URI do deputado na API
  casa             String          // "federal" | "poa"
  urlOriginal      String          // URL do inteiro teor ou ficha de tramitação
  status           String          // Situação atual
  orgaoStatus      String?         // Sigla do órgão atual (ex: "CCTI", "PLEN")
  regime           String?         // Regime de tramitação (ex: "Ordinário", "Urgência")
  apreciacao       String?         // Apreciação (ex: "Aprovação do Plenário")
  codSituacao      Int?            // Código numérico da situação
  aiSummary        String?         // Resumo gerado pela IA (opcional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  keywords      ProposicaoKeyword[]
  tramitacoes   Tramitacao[]
  notifications Notification[]
  votacoes      Votacao[]
}

// Tabela intermediária: quais keywords encontraram cada proposição
model ProposicaoKeyword {
  proposicao   Proposicao @relation(fields: [proposicaoId], references: [id])
  proposicaoId String
  keyword      Keyword    @relation(fields: [keywordId], references: [id])
  keywordId    String

  @@id([proposicaoId, keywordId])
}

// Histórico de tramitação de um PL — reflete os dados reais da API da Câmara
model Tramitacao {
  id                   String     @id @default(cuid())
  proposicaoId         String
  proposicao           Proposicao @relation(fields: [proposicaoId], references: [id])
  sequencia            Int
  descricaoTramitacao  String     // Ação: "Apresentação de Proposição", "Distribuição", etc.
  descricaoSituacao    String     // Status resultante: "Aguardando Relator", etc.
  despacho             String?    // Texto completo do despacho (pode ser longo)
  orgao                String     // Sigla: "MESA", "PLEN", "CCTI"
  regime               String?    // Regime de tramitação naquele momento
  urlDocumento         String?    // Link para o documento da tramitação
  data                 DateTime
  createdAt            DateTime   @default(now())

  @@unique([proposicaoId, sequencia])
}

// Feed de notificações para o usuário
model Notification {
  id           String      @id @default(cuid())
  tipo         String      // "nova_proposicao" | "tramitacao" | "votacao" | "resumo_semanal"
  titulo       String
  mensagem     String
  proposicaoId String?
  proposicao   Proposicao? @relation(fields: [proposicaoId], references: [id])
  read         Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

// Votações agendadas ou realizadas
model Votacao {
  id              String      @id
  proposicaoId    String?
  proposicao      Proposicao? @relation(fields: [proposicaoId], references: [id])
  descricao       String
  orgao           String
  dataHora        DateTime
  resultado       String?     // "Aprovada" | "Rejeitada"
  uri             String?
  createdAt       DateTime    @default(now())
}
