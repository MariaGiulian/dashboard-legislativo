# =============================================================================
# LEGISLA MONITOR — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# Banco de dados SQLite (gerado automaticamente)
DATABASE_URL="file:./dev.db"

# Claude API (Anthropic) — para resumos gerados por IA dos PLs
# Obtenha em: https://console.anthropic.com/
# OPCIONAL: sem esta chave, o app funciona normalmente, apenas sem resumos IA
ANTHROPIC_API_KEY=""

# URL base da aplicação (usada para Vercel Cron Jobs)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segredo para autenticar as chamadas do Cron Job da Vercel
# Gere com: openssl rand -base64 32
CRON_SECRET=""
