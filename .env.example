# =============================================================================
# LEGISLA MONITOR — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# ─── Banco de dados PostgreSQL (Railway) ─────────────────────────────────────
#
# Em desenvolvimento local: use o PostgreSQL do Railway diretamente ou Docker:
#   docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
#
# Para obter as URLs do Railway:
#   1. Acesse railway.app → seu projeto → aba "Connect"
#   2. Copie "DATABASE_URL" (com pooler) → DATABASE_URL abaixo
#   3. Copie "DATABASE_PUBLIC_URL" (direto) → DIRECT_URL abaixo
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:senha@host.railway.app:5432/railway?sslmode=require"

# URL direta (sem pooler) — usada pelo Prisma para migrações
# Mesmo formato da DATABASE_URL, mas sem connection pooler se aplicável
DIRECT_URL="postgresql://postgres:senha@host.railway.app:5432/railway?sslmode=require"

# ─── Claude API (Anthropic) ───────────────────────────────────────────────────
# Para resumos gerados por IA dos PLs
# Obtenha em: https://console.anthropic.com/
# OPCIONAL: sem esta chave, o app funciona normalmente, apenas sem resumos IA
ANTHROPIC_API_KEY=""

# ─── Aplicação ────────────────────────────────────────────────────────────────
# URL base da aplicação (usada para links internos)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron Job (Vercel) ───────────────────────────────────────────────────────
# Segredo para autenticar as chamadas automáticas do Cron Job da Vercel
# Gere com: openssl rand -base64 32
# Configure o mesmo valor nas variáveis de ambiente da Vercel
CRON_SECRET=""
